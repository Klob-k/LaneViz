# LaneViz Secrets Configuration Template
#
# Copy this file to .streamlit/secrets.toml and fill in your actual values
# NEVER commit secrets.toml to version control!

# Database credentials (if needed for yat_geo_db)
# [database]
# host = "your-db-host"
# port = 5432
# username = "your-username"
# password = "your-password"
# database = "your-database-name"

# API Keys (if needed for geocoding services)
# [api_keys]
# geocoding_api_key = "your-api-key-here"

# Application settings
# [app]
# max_upload_size_mb = 200
# enable_caching = true
# cache_ttl_hours = 24
